# Local SRA development configuration.
# Copy this file to .env and replace the blank value with your own key.
# .env is ignored by Git; never commit a real credential.

# Enable the optional LLM evidence gap-filler.
SRA_USE_LLM=1

# Groq's OpenAI-compatible API key.
GROQ_API_KEY=
SRA_LLM_MODEL=qwen/qwen3.8-27b


TINYFISH_API_KEY=
